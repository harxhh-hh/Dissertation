# ---------------------------------------------------------------------------
# Example environment file.
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER put a real API key in this file (.env.example
# IS tracked by git and will be pushed to the University GitLab server).
# ---------------------------------------------------------------------------

# --- Provider selection ----------------------------------------------------
# Which LLM back-end to use. Switching this value between `groq` and
# `anthropic` (with the appropriate API key and MODEL_ID set below) is the
# only edit required to swap providers; no code change is needed.
#
# NOTE: SRS documents produced under different providers are NOT directly
# comparable and MUST NOT be pooled in a single results table. Report per
# provider separately in the dissertation.
LLM_PROVIDER=groq

# --- Credentials (set the one your provider needs) ------------------------
# Anthropic API key (required when LLM_PROVIDER=anthropic).
# Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Groq API key (required when LLM_PROVIDER=groq).
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk-REPLACE-ME

# --- Model configuration ---------------------------------------------------
# Model identifier used by EVERY agent in EVERY architecture and the baseline.
# Holding this constant is required for the controlled comparison.
# Examples:
#   LLM_PROVIDER=anthropic  -> MODEL_ID=claude-opus-5
#   LLM_PROVIDER=groq       -> MODEL_ID=llama-3.3-70b-versatile
# Check https://console.groq.com/docs/models for currently-supported Groq
# model IDs; several older Llama variants have been decommissioned.
MODEL_ID=llama-3.3-70b-versatile

# Maximum output tokens per LLM call.
MAX_TOKENS=16000

# Reasoning effort: low | medium | high | xhigh | max
# Controls how much the model deliberates before answering. Held constant
# across all conditions. Document the chosen value in the dissertation.
# Ignored when LLM_PROVIDER=groq (Groq has no effort concept); the value
# is still recorded in the run's config.json for provenance.
EFFORT=high

# Extended thinking mode: adaptive | disabled
# NOTE: on claude-opus-5, `disabled` is only accepted when EFFORT is `high`
# or lower; pairing `disabled` with `xhigh`/`max` returns an HTTP 400.
# Ignored when LLM_PROVIDER=groq (Groq has no extended-thinking concept);
# the value is still recorded in the run's config.json for provenance.
THINKING_MODE=adaptive

# --- Experiment configuration ----------------------------------------------
# Seed for all Python-side randomness (test-case ordering, rater-export
# shuffling, anonymised ID assignment). See README section "Reproducibility"
# for what this does and does not make deterministic.
RANDOM_SEED=42

# Maximum number of revision rounds the Verification Agent may trigger.
# Bounds cost and guarantees termination.
MAX_REVISION_ROUNDS=1

# Number of independent repetitions of each (architecture x test case) pair.
# >1 lets you quantify run-to-run variance, which LLM sampling makes non-zero.
REPETITIONS=1

# --- Runtime configuration -------------------------------------------------
# Directory (relative to the project root) where run artefacts are written.
OUTPUT_DIR=outputs

# Per-request timeout in seconds, and SDK-level retry count for transient
# errors (HTTP 429/5xx and connection failures).
REQUEST_TIMEOUT_SECONDS=600
MAX_RETRIES=2

# Console log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
