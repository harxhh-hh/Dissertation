# ---------------------------------------------------------------------------
# Secrets and local environment
# ---------------------------------------------------------------------------
# NEVER commit real credentials. Only .env.example (a template with no real
# values) is tracked; every other .env variant is ignored.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json
api_key*
*_api_key*
*.secret

# ---------------------------------------------------------------------------
# Experiment outputs
# ---------------------------------------------------------------------------
# Run artefacts (LLM interaction logs, generated SRS documents, rater exports)
# can be large and are regenerated by run_experiment.py. Ignored by default.
#
# To submit a specific frozen result set alongside the dissertation, force-add
# it explicitly, e.g.:
#     git add -f outputs/run_2026-07-26T12-00-00Z/
outputs/*
!outputs/.gitkeep

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

